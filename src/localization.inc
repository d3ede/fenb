UI_TEXT(SSRQuality, "SSR quality", "Качество SSR")
UI_TEXT(Detailed, "Detailed", "Подробное")
UI_TEXT(SSRQualityHelp, "Performance uses 24 steps and Quality uses 48 unless overridden. Both refine intersections and require readable depth; unsupported hits fall back to sky.", "Быстрый режим использует 24 шага, качественный — 48, если не задано другое значение. Оба уточняют пересечения и требуют читаемой глубины. Ненадёжные попадания заменяются небом.")
UI_TEXT(WaterReflections, "Water reflections", "Отражения воды")
UI_TEXT(ReflectionMethod, "Method", "Режим")
UI_TEXT(ReflectionSkyOnly, "Sky only", "Только небо")
UI_TEXT(ReflectionPerformance, "SSR — Performance", "SSR — Быстрый")
UI_TEXT(ReflectionQuality, "SSR — Quality", "SSR — Качественный")
UI_TEXT(ReflectionResolution, "Resolution", "Разрешение")
UI_TEXT(ReflectionTrace, "Ray tracing controls", "Параметры трассировки")
UI_TEXT(ReflectionSteps, "Ray steps", "Шаги луча")
UI_TEXT(ReflectionStepsHelp, "Samples along the ray. More samples may find smaller objects, but cannot recover hidden or off-screen geometry.", "Выборки вдоль луча. Больше шагов помогает находить мелкие объекты, но не восстанавливает скрытую геометрию и объекты вне кадра.")
UI_TEXT(ReflectionRefinements, "Refinements", "Уточнения")
UI_TEXT(ReflectionRefinementsHelp, "Binary refinements after a depth crossing. This improves intersection precision, not the number of visible objects.", "Двоичные уточнения после пересечения глубины. Повышают точность попадания, а не количество видимых объектов.")
UI_TEXT(ReflectionBias, "Ray start", "Начало луча")
UI_TEXT(ReflectionDistanceHelp, "Maximum reflected ray length in world units. Lower values exclude distant objects.", "Максимальная длина отражённого луча в единицах мира. Меньше значение — ближе предел отражения объектов.")
UI_TEXT(ReflectionBiasHelp, "Initial distance along the reflected ray. Large values can remove nearby reflections.", "Начальное расстояние вдоль отражённого луча. Большие значения могут убирать близкие отражения.")
UI_TEXT(ReflectionThickness, "Depth tolerance", "Допуск глубины")
UI_TEXT(ReflectionThicknessHelp, "Multiplier for depth-hit validation. Excessive tolerance can accept unrelated surfaces; it does not fix missing geometry.", "Множитель допуска при проверке глубины. Завышение может пропускать чужие поверхности и не исправляет отсутствующую геометрию.")
UI_TEXT(ReflectionConfidence, "Confidence cutoff", "Порог надёжности")
UI_TEXT(ReflectionConfidenceHelp, "Fade weakly supported object reflections into sky. Higher values retain fewer uncertain fragments.", "Ослабляет ненадёжные отражения объектов в пользу неба. Чем выше порог, тем меньше сомнительных фрагментов остаётся.")
UI_TEXT(ReflectionSoftFallback, "Soft sky fallback", "Мягкий переход к небу")
UI_TEXT(Caustics, "Caustics", "Каустика")
UI_TEXT(CausticsHelp, "Moving bottom illumination from refracted light. Requires readable depth.", "Подвижное освещение дна преломлённым светом. Нужна читаемая глубина.")
UI_TEXT(Dispersion, "Dispersion", "Дисперсия")
UI_TEXT(DispersionHelp, "Subtle color separation along caustic edges, without distorting the entire screen.", "Слабое разделение цвета по краям каустики, без искажения всего экрана.")
UI_TEXT(CausticQuality, "Caustic quality", "Качество каустики")
UI_TEXT(Saving, "Saving…", "Сохраняется…")
UI_TEXT(Autosave, "Autosave", "Автосохранение")
UI_DIAGNOSTIC_TEXT(CapturePending, "Capture in 3 s — close the panel", "Захват через 3 с — закройте панель")
UI_TEXT(Saved, "Saved", "Сохранено")
UI_TEXT(ConfigWriteFailed, "Could not write FENB.ini", "Ошибка записи FENB.ini")
UI_TEXT(SettingsLoaded, "Settings loaded", "Настройки загружены")
UI_TEXT(ConfigNotFound, "Settings file not found", "Файл настроек не найден")
UI_TEXT(RaysNeedSun, "Face the daytime sun; geometry must interrupt the sky.", "Повернись к дневному солнцу: лучам нужны просветы в геометрии.")
UI_TEXT(SkyNotDetected, "No supported sky material is visible.", "В кадре нет распознанного материала неба.")
UI_TEXT(LightNotDetected, "No supported light source is visible.", "В кадре нет распознанного источника света.")
UI_TEXT(SceneDepthUnavailable, "Scene depth is unavailable.", "Глубина сцены недоступна.")
UI_TEXT(LightingBalance, "Lighting balance", "Баланс освещения")
UI_TEXT(LightingBalanceHelp, "Adapt contrast to world luminance: lift dark surfaces and restrain bright models. Preserves hue; no HUD processing.", "Адаптивный контраст по яркости мира: поднимает тёмные поверхности и сдерживает светлые модели. Сохраняет оттенки, не затрагивает HUD.")

