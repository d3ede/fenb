* text=auto eol=lf

*.png binary
*.dds binary
*.bgra binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary

# Preserve the supplied source model byte-for-byte, independent of checkout EOLs.
assets/grass/universe/env_grass.obj -text

# Keep upstream SMAA sources and lookup tables unchanged, including trailing spaces.
vendor/smaa/SMAA.hlsl whitespace=-blank-at-eol
vendor/smaa/AreaTex.h whitespace=-blank-at-eol
vendor/smaa/SearchTex.h whitespace=-blank-at-eol
